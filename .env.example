# Local development values only. Never commit a filled-in .env.
PORTRAITLAB_ENV=development
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://portraitlab:CHANGE_ME@127.0.0.1:5432/portraitlab
REDIS_URL=redis://127.0.0.1:6379/0

# Object storage (SeaweedFS locally; copy infra/seaweedfs/s3.json.example to s3.json with the same keys)
S3_BUCKET=portraitlab-ephemeral
S3_INTERNAL_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth: set exactly one key source. JWT_DEV_HS256_SECRET is refused when PORTRAITLAB_ENV=production.
JWT_ISSUER=https://auth.example.invalid/
JWT_AUDIENCE=portraitlab-api
JWT_DEV_HS256_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_JWKS_URL=
# JWT_ALGORITHMS=RS256,ES256

# 32+ random bytes used to sign 15-second media capabilities.
MEDIA_TOKEN_SECRET=
CONSENT_POLICY_VERSION=2026-10-01
CREDIT_UNITS_PER_JOB=1

# Integration tests (tests/test_runtime_integration.py); skipped when unset.
PORTRAITLAB_TEST_DATABASE_URL=
PORTRAITLAB_TEST_S3_ENDPOINT=
PORTRAITLAB_TEST_S3_ACCESS_KEY=
PORTRAITLAB_TEST_S3_SECRET_KEY=

# AI Styles app build (public, inlined into the app; it is a URL, not a secret).
# Server settings for the style API live in apps/style-api/.env.example.
EXPO_PUBLIC_STYLE_API_URL=
