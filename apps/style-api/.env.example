# Style API configuration. Placeholder names only: put real values in your hosting provider's
# environment-variable settings (e.g. Vercel > Project > Settings > Environment Variables).
# Never commit a filled-in copy, never put these in the app or any EXPO_PUBLIC_ variable.

# production | development | test. Production refuses unsafe settings at startup.
APP_ENV=production

# Comma-separated browser origins allowed to call the API (scheme + host, no path, no wildcard).
# GitHub Pages origin for this project: https://subashspeaks1m-create.github.io
ALLOWED_ORIGINS=

# Server-only OpenAI key. Without it, /api/generate returns PROVIDER_NOT_CONFIGURED.
OPENAI_API_KEY=
# gpt-image-2 (default) | gpt-image-1.5 | gpt-image-1 | gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium (default) | high | auto. Higher costs more per image.
OPENAI_IMAGE_QUALITY=medium
PROVIDER_TIMEOUT_SECONDS=240

# Persistent rate limiting (required in production; requests fail closed if Upstash is unreachable).
RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret used to hash client IPs before they are stored (32+ random characters).
RATE_LIMIT_SALT=
LIMIT_PER_IP_HOUR=5
LIMIT_PER_IP_DAY=15
LIMIT_GLOBAL_DAY=200

# Upload limits (Vercel caps request bodies at 4.5 MB).
MAX_UPLOAD_BYTES=4000000
MAX_INPUT_PIXELS=16000000
MIN_INPUT_SIDE=256
